{"$schema":"http://json-schema.org/draft-07/schema#","$id":"https://github.com/Grar00t/khawrizm-sovereign-graph/schema/sovereign_knowledge_graph_v2.1.0.json","title":"Sovereign Knowledge Graph Schema v2.1.0","description":"Extended schema with core knowledge types, validated edge relations, and evidence requirements for PostgreSQL/Supabase deployments.","type":"object","required":["nodes","edges","evidence"],"additionalProperties":false,"definitions":{"node_id":{"type":"string","pattern":"^n_[a-z0-9_]{2,64}$","description":"Stable semantic node ID: n_ prefix + 2-64 lowercase alphanumeric/underscore chars"},"evidence_id":{"type":"string","pattern":"^ev_[a-z0-9_]{2,64}$","description":"Evidence ID: ev_ prefix + 2-64 lowercase alphanumeric/underscore chars"},"node_type":{"type":"string","enum":["protocol","technology","language","architecture","practice","standard","component","model","dataset","metric","concept","organization","person"],"description":"Core knowledge node types"},"edge_type":{"type":"string","enum":["implements","depends_on","supports","enables","extends","validates","contradicts","derived_from","related_to","part_of","instance_of","supersedes"],"description":"Validated edge relation types"},"confidence":{"type":"number","minimum":0,"maximum":1,"description":"Confidence score 0.0–1.0"},"node":{"type":"object","required":["id","type","label","description"],"additionalProperties":false,"properties":{"id":{"$ref":"#/definitions/node_id"},"type":{"$ref":"#/definitions/node_type"},"label":{"type":"string","minLength":3,"maxLength":256,"description":"Human-readable label"},"description":{"type":"string","minLength":10,"maxLength":2048,"description":"Detailed description"},"aliases":{"type":"array","items":{"type":"string","minLength":2,"maxLength":128},"minItems":0,"maxItems":10,"uniqueItems":true,"description":"Alternative names"},"scope":{"type":"string","enum":["graph_integrity","data_modeling","query_execution","provenance_verification","quality_assuranc